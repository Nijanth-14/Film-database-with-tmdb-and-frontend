# Existing .env files are preserved. No TMDB key is needed for local playback.
DATABASE_URL=postgresql:///multimedia_db
# Default: the project's media directory. Use an absolute WSL/Linux path to override.
# MEDIA_ROOT=/home/yourname/videos
DB_POOL_SIZE=10
# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Optional; imports only use this when online metadata is explicitly selected.
TMDB_API_KEY=

# Optional additional trusted library folders, separated by semicolons.
# MEDIA_IMPORT_ROOTS="/mnt/c/Users/YourName/Videos;/home/yourname/Movies"
# Prepared full-length copies default to media/.prepared (originals stay unchanged).
# MEDIA_CACHE_ROOT=/path/to/cache
