# .env.example
# Copy this file to .env and fill in your actual TMDB API Key

# TMDB API Key
# 1. Go to https://www.themoviedb.org/ and create an account if you don't have one.
# 2. Go to Settings -> API (https://www.themoviedb.org/settings/api).
# 3. Create a Developer API Key and copy the 'API Key' value here.
TMDB_API_KEY=your_api_key_here

# Optional: override default database URL
# DATABASE_URL=postgresql://user:password@localhost:5432/multimedia_db
